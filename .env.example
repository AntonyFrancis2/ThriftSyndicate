DATABASE_URL="postgresql://USER@localhost:5432/thriftsyndicate?schema=public"
# Hosted (Neon): DATABASE_URL is the pooled "-pooler" URL, DIRECT_URL the direct one used for migrations.
DIRECT_URL=""
TEST_DATABASE_URL="postgresql://USER@localhost:5432/thriftsyndicate_test?schema=public"
# openssl rand -base64 48
SESSION_SECRET=""
# Shared secret for the scheduled-jobs endpoint (/api/cron/sweep)
CRON_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Razorpay test keys (Dashboard → Account & Settings → API keys). Leave empty to use the local mock gateway.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Demos/staging only: lets a production build use the mock gateway. Never set on the live site.
PAYMENTS_MOCK=""

# Product photo uploads (cloudinary.com → Settings → API Keys). Empty = paste image URLs instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (resend.com). EMAIL_FROM must use a domain verified in Resend, e.g. "ThriftSyndicate <orders@thriftsyndicate.in>".
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""

# SMS (msg91.com). Map our templates to DLT-approved MSG91 flow ids, e.g. {"order_placed":"6650…","order_approved":"…"}.
MSG91_AUTH_KEY=""
MSG91_SMS_TEMPLATES=""

# WhatsApp (Meta Cloud API). When set, phone messages go by WhatsApp instead of SMS.
# WHATSAPP_TEMPLATES maps our templates to approved template names, e.g. {"order_placed":"order_placed_v1"}.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATES=""
WHATSAPP_LANGUAGE="en"
